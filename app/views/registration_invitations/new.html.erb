<%= render layout: "shared/page", locals: { title: "メールアドレスの入力", width: :narrow, hide_heading: true } do %>
  <p>登録用のリンクを受け取るメールアドレスを入力してください。</p>
  <% if @error %><p role="alert"><%= @error %></p><% end %>
  <%= form_with url: registration_invitation_path, class: "ui-form ui-form--stacked" do |form| %>
    <%= form.email_field :email, label: "メールアドレス", value: params[:email], required: true, autocomplete: "email" %>
    <div class="ui-form-actions"><%= form.submit "確認メール送信" %></div>
  <% end %>
<% end %>
