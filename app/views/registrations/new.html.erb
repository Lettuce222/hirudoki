<% content_for :title, "利用者登録｜ひるどき" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<h1 class="visually-hidden">利用者登録</h1>
<p>氏名・電話番号と、ログインに使うパスワードを入力してください。</p>
<% if @user.errors.any? %>
  <ul role="alert">
    <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
  </ul>
<% end %>
<%= form_with model: @user, url: registration_path do |form| %>
  <%= hidden_field_tag :token, params[:token] %>
  <%= form.label :name, "氏名" %>
  <%= form.text_field :name, required: true, autocomplete: "name" %>
  <%= form.label :phone, "電話番号" %>
  <%= form.telephone_field :phone, required: true, autocomplete: "tel" %>
  <%= form.label :password, "パスワード" %>
  <p id="password-hint">半角英数字・記号で<%= User.password_length.min %>〜<%= User.password_length.max %>文字。空白は使えません。</p>
  <%= form.password_field :password, required: true, minlength: User.password_length.min, aria: { describedby: "password-hint" }, autocomplete: "new-password" %>
  <%= form.label :password_confirmation, "パスワード（確認）" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  <p>確認済みメールアドレス<br><%= @user.email %></p>
  <%= form.submit "登録", class: "primary" %>
<% end %>
