<%= render layout: "shared/page", locals: { title: "利用者登録", width: :form, hide_heading: true } do %>
  <p>氏名・電話番号と、ログインに使うパスワードを入力してください。</p>
  <%= render "shared/form_errors", record: @user %>
  <%= form_with model: @user, url: registration_path, class: "ui-form" do |form| %>
    <%= hidden_field_tag :token, params[:token] %>
    <%= form.text_field :name, label: "氏名", required: true, autocomplete: "name" %>
    <%= form.telephone_field :phone, label: "電話番号", required: true, autocomplete: "tel" %>
    <div>
      <%= form.password_field :password, label: "パスワード", required: true, minlength: User.password_length.min, aria: { describedby: "password-hint" }, autocomplete: "new-password" %>
      <p id="password-hint" class="ui-hint">半角英数字・記号で<%= User.password_length.min %>〜<%= User.password_length.max %>文字。空白は使えません。</p>
    </div>
    <%= form.password_field :password_confirmation, label: "パスワード（確認）", required: true, autocomplete: "new-password" %>
    <p class="ui-form-wide">確認済みメールアドレス<br><%= @user.email %></p>
    <div class="ui-form-actions"><%= form.submit "登録" %></div>
  <% end %>
<% end %>
