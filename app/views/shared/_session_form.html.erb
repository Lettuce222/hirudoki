<%= form_with model: resource, url: session_path(resource_name), class: "ui-form ui-form--stacked" do |form| %>
  <%= form.email_field :email, label: "メールアドレス", required: true, autocomplete: "username" %>
  <%= form.password_field :password, label: "パスワード", required: true, autocomplete: "current-password" %>
  <div class="ui-form-actions"><%= form.submit "ログイン" %></div>
<% end %>
