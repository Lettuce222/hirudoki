<%# locals: (title:, back:, width: :wide, primary_action: nil) %>
<% content_for :title, "#{title}｜ひるどき" %>
<% content_for :body_class, "customer-ui" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<section class="customer-page customer-page--<%= width %>">
  <nav class="customer-back" aria-label="戻り先">
    <%= link_to(*back) %>
  </nav>
  <div class="customer-page-heading">
    <h1><%= title %></h1>
    <% if primary_action %>
      <%= primary_action %>
    <% end %>
  </div>
  <%= yield %>
</section>
