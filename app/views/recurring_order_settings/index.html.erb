<% content_for :title, "定期注文設定｜ひるどき" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<p><%= link_to "マイページ", profile_path %></p>
<h1>定期注文設定</h1>
<p><%= link_to "定期設定登録", new_recurring_order_setting_path, class: "primary" %></p>
<% if @settings.any? %>
  <ul>
    <% @settings.each do |setting| %>
      <li>
        <strong><%= t("date.day_names").fetch(setting.weekday) %></strong>
        <%= setting.bento_type %>・<%= setting.quantity %>個・<%= setting.active? ? "有効" : "無効" %><br>
        <%= setting.delivery_area.name %> <%= setting.delivery_address %>
        <%= link_to "#{t('date.day_names').fetch(setting.weekday)}の設定を編集", edit_recurring_order_setting_path(setting), class: "underline" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>定期注文の設定はまだありません。</p>
<% end %>
