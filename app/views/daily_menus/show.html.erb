<% navigation = render "shared/breadcrumbs", items: [ [ "献立一覧", daily_menus_path(@filters.to_h) ], [ @menu.bento.name ] ] %>
<%= render layout: "shared/page", locals: { title: @menu.bento.name, navigation: } do %>
  <div class="menu-detail">
    <%= render "photo", bento: @menu.bento %>
    <div class="ui-panel">
      <% remaining = @menu.remaining_quantity %>
      <%= render "information", menu: @menu, remaining: %>
      <% if @menu.accepting_orders? && remaining.positive? %>
        <%= primary_action_link "注文手続き", new_daily_menu_order_path(@menu) %>
      <% elsif remaining.zero? %>
        <p>売り切れです。</p>
      <% else %>
        <p>注文の受付期間外です。当日は午前10時に締め切ります。</p>
      <% end %>
      <%= render "reviews", menu: @menu, reviews: @reviews %>
    </div>
  </div>
<% end %>
