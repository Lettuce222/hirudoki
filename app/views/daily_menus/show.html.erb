<% content_for :title, "#{@menu.bento.name}｜ひるどき" %>
<div class="customer-menus">
  <nav class="menu-crumbs" aria-label="パンくず">
    <ol>
      <li><%= link_to "献立一覧", daily_menus_path(@filters.to_h) %></li>
      <li aria-current="page"><%= @menu.bento.name %></li>
    </ol>
  </nav>
  <h1><%= @menu.bento.name %></h1>
  <div class="menu-detail">
    <%= render "photo", bento: @menu.bento %>
    <div>
      <p><%= @menu.served_on %>・<%= @menu.bento.bento_type %></p>
      <% remaining = @menu.remaining_quantity %>
      <p><strong><%= @menu.bento.price %>円（税抜）</strong>　残り<%= remaining %>個</p>
      <p><%= @menu.bento.description %></p>
      <% if @menu.accepting_orders? && remaining.positive? %>
        <%= link_to "注文手続き", new_daily_menu_order_path(@menu), class: "primary" %>
      <% elsif remaining.zero? %>
        <p>売り切れです。</p>
      <% else %>
        <p>注文の受付期間外です。当日は午前10時に締め切ります。</p>
      <% end %>
      <h2>評価</h2>
      <p>まだ評価はありません。</p>
    </div>
  </div>
</div>
