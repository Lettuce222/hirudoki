<% navigation = render "shared/breadcrumbs", items: [ [ "マイページ", profile_path ], [ "注文詳細", order_path(@order) ], [ "評価投稿" ] ] %>
<%= render layout: "shared/page", locals: { title: "評価投稿", navigation: } do %>
  <div class="ui-split review-layout">
    <section class="ui-panel review-menu">
      <%= render "daily_menus/photo", bento: @menu.bento %>
      <%= render "daily_menus/information", menu: @menu, remaining: @menu.remaining_quantity, show_name: true %>
    </section>
    <div class="review-input">
      <%= render "shared/form_errors", record: @review %>
      <% if @order.reviewable? %>
        <%= form_with model: @review, url: order_review_path(@order), class: "ui-form ui-form--stacked" do |form| %>
          <%= form.select :rating, 5.downto(1).map { |rating| [ "#{rating}点", rating ] }, { include_blank: "選択してください" }, label: "評価", required: true %>
          <%= form.text_area :comment, rows: 3, label: "コメント（任意）" %>
          <div class="ui-form-actions"><%= form.submit "評価投稿" %></div>
        <% end %>
      <% end %>
    </div>
    <section class="ui-panel review-existing">
      <%= render "daily_menus/reviews", menu: @menu, reviews: @reviews %>
    </section>
  </div>
<% end %>
