<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Hirudoki" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hirudoki">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if response.cache_control[:no_store] %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <% if controller_path.start_with?("admin/") %>
        <%= link_to "ひるどき　管理画面", admin_root_path %>
      <% else %>
        <% brand_path = user_signed_in? ? daily_menus_path : new_user_session_path %>
        <%= link_to brand_path, class: "site-brand" do %>
          <span class="site-brand-mark" aria-hidden="true"></span>
          <span>ひるどき</span>
        <% end %>
        <% if user_signed_in? || current_page?(root_path) %>
          <nav class="site-user-nav" aria-label="利用者メニュー">
            <% if user_signed_in? %>
              <%= link_to "献立一覧", daily_menus_path, class: "btn btn-transparent site-order-link", aria: { current: ("page" if current_page?(daily_menus_path)) } %>
              <%= link_to "定期注文設定", recurring_order_settings_path, class: "btn btn-transparent site-order-link", aria: { current: ("page" if current_page?(recurring_order_settings_path)) } %>
              <%= link_to profile_path, class: "site-profile-link", title: "マイページ" do %>
                <span class="site-profile-icon" aria-hidden="true"></span>
                <span class="visually-hidden">マイページ</span>
              <% end %>
            <% else %>
              <%= link_to "ログイン", new_user_session_path %>
            <% end %>
          </nav>
        <% end %>
      <% end %>
    </header>
    <main class="content">
      <% if notice %><p role="status"><%= notice %></p><% end %>
      <% if alert %><p role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
