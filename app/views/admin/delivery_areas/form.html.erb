<% action = @delivery_area.persisted? ? "編集" : "登録" %>
<%= render layout: "admin/shared/page", locals: { title: "配達エリアの#{action}", section: "配達エリア", index_path: admin_delivery_areas_path, current: action, width: :form } do %>
  <%= render "shared/form_errors", record: @delivery_area %>
  <%= form_with model: [:admin, @delivery_area], class: "ui-form" do |form| %>
    <%= form.text_field :name, label: "エリア名", required: true %>
    <div>
      <%= form.text_field :postal_code, label: "郵便番号", inputmode: "numeric", pattern: "[0-9]{7}", maxlength: 7, required: true, aria: { describedby: "postal-format" } %>
      <p id="postal-format" class="ui-hint">ハイフンを除く半角数字7桁で入力してください。</p>
    </div>
    <%= form.check_box :active, label: "有効" %>
    <div class="ui-form-actions"><%= form.submit "保存" %></div>
  <% end %>
  <%= render "admin/shared/delete", record: @delivery_area %>
<% end %>
