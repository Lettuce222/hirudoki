<% content_for :title, "配達エリア｜管理画面｜ひるどき" %>
<%= render "admin/shared/breadcrumbs", current: "配達エリア" %>
<div class="catalog-heading">
  <h1>配達エリア</h1>
  <%= link_to "配達エリア登録", new_admin_delivery_area_path, class: "primary" %>
</div>
<div class="catalog-grid" role="region" aria-label="配達エリア一覧" tabindex="0">
  <table>
    <thead>
      <tr>
        <th scope="col">エリア名</th>
        <th scope="col">郵便番号</th>
        <th scope="col">状態</th>
        <th scope="col">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @delivery_areas.each do |delivery_area| %>
        <tr>
          <td><%= delivery_area.name %></td>
          <td><%= delivery_area.postal_code %></td>
          <td><%= delivery_area.active? ? "有効" : "無効" %></td>
          <td><%= link_to "編集", edit_admin_delivery_area_path(delivery_area), aria: { label: "#{delivery_area.name}の編集" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @delivery_areas.empty? %><p>配達エリアはまだ登録されていません。</p><% end %>
