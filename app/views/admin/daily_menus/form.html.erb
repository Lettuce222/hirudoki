<% action = @daily_menu.persisted? ? "編集" : "登録" %>
<% delete_action = render("admin/shared/delete", record: @daily_menu) if @daily_menu.persisted? %>
<%= render layout: "admin/shared/page", locals: { title: "日別献立の#{action}", section: "日別献立", index_path: admin_daily_menus_path, current: action, width: :form, primary_action: delete_action } do %>
  <%= render "shared/form_errors", record: @daily_menu %>
  <%= form_with model: [:admin, @daily_menu], class: "ui-form" do |form| %>
    <%= form.date_field :served_on, label: "提供日", required: true %>
    <%= form.select :bento_id, @bentos.map { |bento| [ bento.name, bento.id ] }, { prompt: "選択してください" }, label: "弁当", required: true %>
    <% if @bentos.empty? %>
      <p class="ui-form-wide">先に<%= link_to "弁当登録", new_admin_bento_path %>で弁当を登録してください。</p>
    <% end %>
    <%= form.number_field :capacity, label: "提供数上限（個）", min: 0, required: true %>
    <div class="ui-form-actions"><%= form.submit "保存" %></div>
  <% end %>
<% end %>
