<%= render layout: "admin/shared/page", locals: { title: "注文 ##{@order.id}", document_title: "注文詳細", current: "注文詳細", section: "注文一覧", index_path: admin_orders_path } do %>
  <%= render "shared/form_errors", record: @order %>
  <div class="ui-split">
    <%= form_with model: [:admin, @order], class: "ui-form ui-form--stacked" do |form| %>
      <%= form.select :status, Order.statuses.map { |status, label| [ label, status ] }, {}, label: "注文状態" %>
      <div class="ui-form-actions"><%= form.submit "保存" %></div>
    <% end %>
    <dl class="ui-panel">
      <dt>提供日</dt><dd><%= @order.daily_menu.served_on.iso8601 %></dd>
      <dt>利用者</dt><dd><%= link_to @order.user.name, admin_user_path(@order.user) %></dd>
      <dt>弁当</dt><dd><%= @order.daily_menu.bento.name %></dd>
      <dt>個数</dt><dd><%= @order.quantity %>個</dd>
      <dt>注文区分</dt><dd><%= @order.recurring? ? "定期" : "手動" %></dd>
      <dt>配達先</dt><dd><%= @order.delivery_area.name %> <%= @order.delivery_address %></dd>
      <dt>電話番号</dt><dd><%= @order.user.phone %></dd>
      <dt>合計</dt><dd>税込<%= number_with_delimiter(@order.total_amount) %>円</dd>
    </dl>
  </div>
<% end %>
