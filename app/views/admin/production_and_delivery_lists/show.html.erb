<%= render layout: "admin/shared/page", locals: { title: "製造・配達リスト" } do %>
  <%= form_with url: admin_production_and_delivery_list_path, method: :get, class: "ui-form ui-form--filter" do |form| %>
    <%= form.date_field :served_on, label: "提供日", value: @served_on, required: true %>
    <div class="ui-form-actions"><%= form.submit "表示" %></div>
  <% end %>
  <% if @served_on %>
    <h2>製造リスト</h2>
    <% if @production_quantities.any? %>
      <%= render layout: "shared/table", locals: { label: "製造リスト", columns: [ "弁当", "合計個数" ] } do %>
        <% @production_quantities.each do |(_, bento_name), quantity| %>
          <tr><th scope="row"><%= bento_name %></th><td><%= quantity %>個</td></tr>
        <% end %>
      <% end %>
    <% else %>
      <p>製造する弁当はありません。</p>
    <% end %>

    <h2>配達リスト</h2>
    <% if @deliveries.any? %>
      <%= render layout: "shared/table", locals: { label: "配達リスト", columns: [ "注文番号", "配達エリア", "住所", "電話番号", "弁当", "個数" ] } do %>
        <% @deliveries.each do |order| %>
          <tr>
            <th scope="row"><%= link_to "注文 ##{order.id}", admin_order_path(order) %></th>
            <td><%= order.delivery_area.name %></td>
            <td><%= order.delivery_address %></td>
            <td><%= order.user.phone %></td>
            <td><%= order.daily_menu.bento.name %></td>
            <td><%= order.quantity %>個</td>
          </tr>
        <% end %>
      <% end %>
    <% else %>
      <p>配達する注文はありません。</p>
    <% end %>
  <% end %>
<% end %>
