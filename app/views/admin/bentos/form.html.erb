<% action = @bento.persisted? ? "編集" : "登録" %>
<%= render layout: "admin/shared/page", locals: { title: "弁当の#{action}", section: "弁当", index_path: admin_bentos_path, current: action, width: :form } do %>
  <%= render "shared/form_errors", record: @bento %>
  <%= form_with model: [:admin, @bento], class: "ui-form" do |form| %>
    <%= form.text_field :name, label: "弁当名", required: true, wrapper: { class: "ui-form-wide" } %>
    <%= form.text_area :description, label: "説明", rows: 3, wrapper: { class: "ui-form-wide" } %>
    <%= form.select :bento_type, Bento::BENTO_TYPES, {}, label: "タイプ" %>
    <%= form.number_field :price, label: "税抜価格（円）", min: 0, required: true %>
    <%= form.number_field :display_order, label: "表示順", required: true %>
    <div class="ui-form-wide bento-image-field" data-controller="image-preview">
      <% if @registered_image %>
        <%= image_tag @registered_image, class: "bento-image-preview", alt: "#{@bento.name}の登録画像", data: { image_preview_target: "original" } %>
      <% end %>
      <img class="bento-image-preview" alt="選択した弁当画像" data-image-preview-target="preview" hidden>
      <%= form.file_field :image, label: "弁当画像", accept: Bento::IMAGE_TYPES.join(","), data: { action: "change->image-preview#update" } %>
    </div>
    <%= form.check_box :on_sale, label: "販売中" %>
    <div class="ui-form-actions"><%= form.submit "保存" %></div>
  <% end %>
  <%= render "admin/shared/delete", record: @bento %>
<% end %>
