<%= render layout: "admin/shared/page", locals: { title: "定期注文生成" } do %>
  <%= render "shared/form_errors", record: @generation %>
  <%= form_with model: @generation, url: admin_recurring_order_generations_path, method: :post, class: "ui-form ui-form--filter", data: { turbo: false } do |form| %>
    <%= form.date_field :served_on, label: "提供日", min: Date.current, max: Date.current + 14, required: true %>
    <div class="ui-form-actions"><%= form.submit "定期注文生成" %></div>
  <% end %>
  <% if @generated %>
    <h2>生成結果</h2>
    <p><%= @generation.served_on.iso8601 %> 提供</p>
    <p role="status">生成 <%= @generation.orders.size %>件・スキップ <%= @generation.skips.size %>件</p>
    <% if @generation.skips.any? %>
      <%= render layout: "shared/table", locals: { label: "スキップした定期注文", columns: [ "利用者", "理由" ] } do %>
        <% @generation.skips.each do |skip| %>
          <tr><td><%= skip.user_name %></td><td><%= skip.reason %></td></tr>
        <% end %>
      <% end %>
    <% end %>
    <% if @generation.orders.any? %>
      <p class="ui-links"><%= link_to "注文一覧", admin_orders_path %></p>
    <% end %>
  <% end %>
<% end %>
