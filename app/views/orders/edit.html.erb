<% navigation = render "shared/breadcrumbs", items: [ [ "マイページ", profile_path ], [ "注文詳細", order_path(@order) ], [ "個数変更" ] ] %>
<%= render layout: "shared/page", locals: { title: "個数変更", navigation:, width: :form } do %>
  <p><%= @order.daily_menu.served_on.iso8601 %> 提供・<%= @order.daily_menu.bento.name %></p>
  <%= render "shared/form_errors", record: @order %>
  <% if @order.changeable? %>
    <%= form_with model: @order, class: "ui-form ui-form--stacked" do |form| %>
      <%= form.select :quantity, order_quantity_options(unit_price: @order.unit_price, unit_discount: @order.unit_discount, remaining: Order::DAILY_LIMIT), {}, label: "変更後の個数" %>
      <div class="ui-form-actions"><%= form.submit "保存" %></div>
    <% end %>
  <% end %>
<% end %>
