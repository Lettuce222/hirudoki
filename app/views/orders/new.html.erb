<% navigation = render "shared/breadcrumbs", items: [ [ "献立一覧", daily_menus_path ], [ @menu.bento.name, daily_menu_path(@menu) ] ] %>
<%= render layout: "shared/page", locals: { title: "注文手続き", navigation:, width: :form } do %>
  <% remaining = @menu.remaining_quantity %>
  <p><strong><%= @menu.bento.name %></strong><br><%= @menu.served_on %> 提供・残り<%= remaining %>個</p>
  <%= render "shared/form_errors", record: @order %>
  <% if @menu.accepting_orders? && remaining.positive? && @areas.any? %>
    <p>個数と配達先を指定してください。代金は月末締めの請求書払いです。</p>
    <%= form_with model: [@menu, @order], class: "ui-form" do |form| %>
      <%= form.select :quantity, order_quantity_options(@menu, remaining), {}, label: "個数" %>
      <%= form.select :delivery_area_id, @areas.map { |area| [ area.name, area.id ] }, { include_blank: "選択してください" }, label: "配達エリア", required: true %>
      <%= form.text_field :delivery_address, label: "配達先住所", required: true, autocomplete: "street-address", wrapper: { class: "ui-form-wide" } %>
      <div class="ui-form-actions"><%= form.submit "注文確定" %></div>
    <% end %>
  <% else %>
    <p>現在、この献立の注文を受け付けていません。</p>
  <% end %>
<% end %>
